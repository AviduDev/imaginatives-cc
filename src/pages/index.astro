---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Imaginatives.cc — A creative agency that helps brands go beyond imagination. Website launching soon." />
  <title>Imaginatives.cc — Coming Soon</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink: #0d0c0a;
      --cream: #f5f0e8;
      --gold: #c9a84c;
      --gold-light: #e8d49a;
      --muted: #6b6456;
      --border: rgba(201,168,76,0.25);
    }

    html { height: 100%; }

    body {
      font-family: 'Cormorant Garamond', Georgia, serif;
      background-color: var(--ink);
      color: var(--cream);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* Grain overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 100;
      opacity: 0.35;
    }

    /* Radial glow */
    .glow {
      position: fixed;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,168,76,0.08) 0%, transparent 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      animation: pulseGlow 6s ease-in-out infinite;
    }

    @keyframes pulseGlow {
      0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
      50% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
    }

    /* Decorative lines */
    .deco-line {
      position: fixed;
      background: linear-gradient(to bottom, transparent, var(--border), transparent);
      width: 1px;
      height: 100vh;
      top: 0;
      pointer-events: none;
    }
    .deco-line-left { left: 10%; animation: lineFade 4s ease-in-out infinite; }
    .deco-line-right { right: 10%; animation: lineFade 4s ease-in-out infinite 2s; }

    @keyframes lineFade {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.7; }
    }

    /* Layout */
    .wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 2rem;
      position: relative;
      z-index: 1;
    }

    /* Top badge */
    .badge {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      font-weight: 300;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid var(--border);
      padding: 0.5rem 1.2rem;
      margin-bottom: 3.5rem;
      opacity: 0;
      animation: fadeUp 1s ease 0.2s forwards;
    }

    /* Logo / Brand name */
    .brand {
      text-align: center;
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: fadeUp 1s ease 0.5s forwards;
    }

    .brand-name {
      font-size: clamp(3.5rem, 10vw, 7.5rem);
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 0.9;
      color: var(--cream);
    }

    .brand-name em {
      font-style: italic;
      color: var(--gold);
    }

    .brand-tld {
      font-family: 'DM Mono', monospace;
      font-size: clamp(0.7rem, 1.5vw, 0.9rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-top: 0.4rem;
    }

    /* Divider */
    .divider {
      width: 80px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      margin: 2rem auto;
      opacity: 0;
      animation: fadeUp 1s ease 0.8s forwards;
    }

    /* Tagline */
    .tagline {
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      font-weight: 300;
      font-style: italic;
      color: var(--cream);
      text-align: center;
      max-width: 520px;
      line-height: 1.6;
      opacity: 0;
      animation: fadeUp 1s ease 1s forwards;
    }

    /* Services pills */
    .services {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      margin-top: 2.5rem;
      max-width: 600px;
      opacity: 0;
      animation: fadeUp 1s ease 1.3s forwards;
    }

    .service-pill {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid rgba(201,168,76,0.15);
      padding: 0.45rem 0.9rem;
      transition: color 0.3s, border-color 0.3s;
    }

    .service-pill:hover {
      color: var(--gold-light);
      border-color: rgba(201,168,76,0.45);
    }

    /* Countdown */
    .countdown-section {
      margin-top: 3.5rem;
      opacity: 0;
      animation: fadeUp 1s ease 1.6s forwards;
    }

    .countdown-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: center;
      margin-bottom: 1.2rem;
    }

    .countdown {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
    }

    .countdown-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
    }

    .countdown-num {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 300;
      color: var(--cream);
      line-height: 1;
      min-width: 2.5ch;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .countdown-sep {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      color: var(--border);
      line-height: 1;
      padding-top: 0.1rem;
    }

    .countdown-unit-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.5rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* Notify form */
    .notify-section {
      margin-top: 3rem;
      text-align: center;
      opacity: 0;
      animation: fadeUp 1s ease 1.9s forwards;
    }

    .notify-label {
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1rem;
    }

    .notify-form {
      display: flex;
      gap: 0;
      max-width: 380px;
      margin: 0 auto;
    }

    .notify-input {
      flex: 1;
      background: transparent;
      border: 1px solid var(--border);
      border-right: none;
      color: var(--cream);
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      padding: 0.8rem 1rem;
      outline: none;
      transition: border-color 0.3s;
    }

    .notify-input::placeholder { color: var(--muted); }
    .notify-input:focus { border-color: rgba(201,168,76,0.5); }

    .notify-btn {
      background: var(--gold);
      border: 1px solid var(--gold);
      color: var(--ink);
      font-family: 'DM Mono', monospace;
      font-size: 0.6rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 0.8rem 1.2rem;
      cursor: pointer;
      transition: background 0.3s, opacity 0.3s;
      white-space: nowrap;
    }

    .notify-btn:hover { background: var(--gold-light); border-color: var(--gold-light); }

    .notify-success {
      font-family: 'DM Mono', monospace;
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      color: var(--gold);
      margin-top: 0.8rem;
      display: none;
    }

    /* Footer */
    footer {
      margin-top: 4rem;
      font-family: 'DM Mono', monospace;
      font-size: 0.55rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: center;
      opacity: 0;
      animation: fadeUp 1s ease 2.2s forwards;
    }

    footer a {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.3s;
    }
    footer a:hover { color: var(--gold); }

    /* Animations */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Floating corner ornaments */
    .ornament {
      position: fixed;
      width: 60px;
      height: 60px;
      pointer-events: none;
      opacity: 0.25;
    }

    .ornament svg { width: 100%; height: 100%; }
    .ornament-tl { top: 2rem; left: 2rem; }
    .ornament-tr { top: 2rem; right: 2rem; transform: scaleX(-1); }
    .ornament-bl { bottom: 2rem; left: 2rem; transform: scaleY(-1); }
    .ornament-br { bottom: 2rem; right: 2rem; transform: scale(-1); }

    @media (max-width: 600px) {
      .deco-line { display: none; }
      .ornament { width: 40px; height: 40px; }
      .countdown { gap: 0.8rem; }
      .notify-form { flex-direction: column; }
      .notify-input { border-right: 1px solid var(--border); border-bottom: none; }
    }
  </style>
</head>
<body>

  <!-- Atmosphere -->
  <div class="glow"></div>
  <div class="deco-line deco-line-left"></div>
  <div class="deco-line deco-line-right"></div>

  <!-- Corner ornaments -->
  <div class="ornament ornament-tl">
    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 2 L2 30" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L30 2" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L12 12" stroke="#c9a84c" stroke-width="0.5" opacity="0.5"/>
    </svg>
  </div>
  <div class="ornament ornament-tr">
    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 2 L2 30" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L30 2" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L12 12" stroke="#c9a84c" stroke-width="0.5" opacity="0.5"/>
    </svg>
  </div>
  <div class="ornament ornament-bl">
    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 2 L2 30" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L30 2" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L12 12" stroke="#c9a84c" stroke-width="0.5" opacity="0.5"/>
    </svg>
  </div>
  <div class="ornament ornament-br">
    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M2 2 L2 30" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L30 2" stroke="#c9a84c" stroke-width="0.8"/>
      <path d="M2 2 L12 12" stroke="#c9a84c" stroke-width="0.5" opacity="0.5"/>
    </svg>
  </div>

  <div class="wrapper">

    <div class="badge">Something extraordinary is brewing</div>

    <div class="brand">
      <div class="brand-name"><em>Imaginatives</em></div>
      <div class="brand-tld">imaginatives.cc</div>
    </div>

    <div class="divider"></div>

    <p class="tagline">
      Go Beyond Imagination.<br/>Build a Brand That Converts.
    </p>

    <div class="services">
      <span class="service-pill">Website Design</span>
      <span class="service-pill">Photography &amp; Video</span>
      <span class="service-pill">Social Media Ads</span>
      <span class="service-pill">Digital Designs</span>
    </div>

    <div class="countdown-section">
      <div class="countdown-label">Launching in</div>
      <div class="countdown">
        <div class="countdown-unit">
          <span class="countdown-num" id="days">00</span>
          <span class="countdown-unit-label">Days</span>
        </div>
        <span class="countdown-sep">·</span>
        <div class="countdown-unit">
          <span class="countdown-num" id="hours">00</span>
          <span class="countdown-unit-label">Hours</span>
        </div>
        <span class="countdown-sep">·</span>
        <div class="countdown-unit">
          <span class="countdown-num" id="minutes">00</span>
          <span class="countdown-unit-label">Mins</span>
        </div>
        <span class="countdown-sep">·</span>
        <div class="countdown-unit">
          <span class="countdown-num" id="seconds">00</span>
          <span class="countdown-unit-label">Secs</span>
        </div>
      </div>
    </div>

    <div class="notify-section">
      <div class="notify-label">Get notified at launch</div>
      <div class="notify-form">
        <input
          class="notify-input"
          type="email"
          id="emailInput"
          placeholder="your@email.com"
          autocomplete="email"
        />
        <button class="notify-btn" id="notifyBtn" type="button">Notify Me</button>
      </div>
      <div class="notify-success" id="notifySuccess">✦ You're on the list. We'll be in touch.</div>
    </div>

    <footer>
      <p>© 2025 Imaginatives &nbsp;·&nbsp; <a href="mailto:hello@imaginatives.cc">hello@imaginatives.cc</a></p>
    </footer>

  </div>

  <script>
    // Countdown to launch — set your target date here
    const LAUNCH_DATE = new Date('2025-09-01T00:00:00');

    function pad(n) {
      return String(Math.max(0, n)).padStart(2, '0');
    }

    function updateCountdown() {
      const now = new Date();
      const diff = LAUNCH_DATE - now;

      if (diff <= 0) {
        document.getElementById('days').textContent = '00';
        document.getElementById('hours').textContent = '00';
        document.getElementById('minutes').textContent = '00';
        document.getElementById('seconds').textContent = '00';
        return;
      }

      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);

      document.getElementById('days').textContent = pad(d);
      document.getElementById('hours').textContent = pad(h);
      document.getElementById('minutes').textContent = pad(m);
      document.getElementById('seconds').textContent = pad(s);
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // Notify button
    document.getElementById('notifyBtn').addEventListener('click', () => {
      const email = document.getElementById('emailInput').value.trim();
      const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!re.test(email)) {
        document.getElementById('emailInput').style.borderColor = 'rgba(255,100,100,0.5)';
        setTimeout(() => {
          document.getElementById('emailInput').style.borderColor = '';
        }, 1500);
        return;
      }
      // In production, send `email` to your backend / mailing list
      console.log('Notify:', email);
      document.querySelector('.notify-form').style.display = 'none';
      const success = document.getElementById('notifySuccess');
      success.style.display = 'block';
    });
  </script>

</body>
</html>
